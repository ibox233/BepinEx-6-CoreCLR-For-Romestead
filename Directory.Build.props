<Project>
    <PropertyGroup>
        <VersionPrefix>6.0.0</VersionPrefix>
        <Authors>BepInEx</Authors>
        <LangVersion>latest</LangVersion>
        <Nullable>disable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <PackageLicenseExpression>LGPL-2.1-only</PackageLicenseExpression>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <DebugType>embedded</DebugType>
        <Configurations>Debug;Release</Configurations>
        <PackageProjectUrl>https://github.com/ibox233/BepinEx-6-CoreCLR-For-Romestead</PackageProjectUrl>
        <RepositoryUrl>https://github.com/ibox233/BepinEx-6-CoreCLR-For-Romestead</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <Copyright>Copyright © 2022 BepInEx Team</Copyright>
        <BuildDir>$(SolutionDir)bin</BuildDir>
        <PackageOutputPath>$(BuildDir)/NuGet</PackageOutputPath>
    </PropertyGroup>
</Project>
