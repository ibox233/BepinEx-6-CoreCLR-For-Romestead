<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Description>BepInEx support library for CoreCLR games</Description>
        <TargetFrameworks>net8.0</TargetFrameworks>
        <OutputPath>$(BuildDir)/NET.CoreCLR</OutputPath>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
        <RomesteadLoaderVersion Condition="'$(RomesteadLoaderVersion)' == ''">0.4.2</RomesteadLoaderVersion>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\BepInEx.NET.Common\BepInEx.NET.Common.csproj"/>
        <ProjectReference Include="..\..\..\BepInEx.Preloader.Core\BepInEx.Preloader.Core.csproj"/>
    </ItemGroup>

    <Import Project="..\BepInEx.NET.Shared\BepInEx.NET.Shared.projitems" Label="Shared"/>

    <Target Name="SetRomesteadBuildInfo" BeforeTargets="GetAssemblyAttributes" DependsOnTargets="InitializeSourceControlInformation">
        <PropertyGroup>
            <RomesteadBuildDate Condition="'$(RomesteadBuildDate)' == ''">$([System.DateTime]::UtcNow.ToString('yyyy-MM-dd HH:mm:ss')) UTC</RomesteadBuildDate>
            <RomesteadCommit Condition="'$(SourceRevisionId)' != ''">$(SourceRevisionId)</RomesteadCommit>
            <RomesteadCommit Condition="'$(SourceRevisionId)' == ''">unknown</RomesteadCommit>
        </PropertyGroup>
        <ItemGroup>
            <AssemblyMetadata Include="RomesteadLoaderVersion" Value="$(RomesteadLoaderVersion)"/>
            <AssemblyMetadata Include="RomesteadBuildDate" Value="$(RomesteadBuildDate)"/>
            <AssemblyMetadata Include="RomesteadCommit" Value="$(RomesteadCommit)"/>
        </ItemGroup>
    </Target>
</Project>
